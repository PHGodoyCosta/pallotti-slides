      "source": "manual",
      "source_url": null,
      "stanzas": [
        {
          "id": 1,
          "type": "verse",
          "lines": [
            {
              "text": "Glória, glória, glória, glória",
              "bold": true
            },
            {
              "text": "Glória a Deus lá nas alturas",
              "bold": false
            },
            {
              "text": "Paz na terra aos seus amados",
              "bold": false
            },
            {
              "text": "A vos louvam Rei celeste",
              "bold": false
            },
            {
              "text": "Os que foram libertados",
              "bold": false
            }
          ]
        },
        {
          "id": 2,
          "type": "verse",
          "lines": [
            {
              "text": "Deus e Pai nós Vos louvamos",
              "bold": false
            },
            {
              "text": "Adoramos, bendizemos",
              "bold": false
            },
            {
              "text": "Damos glória ao Vosso nome",
              "bold": false
            },
            {
              "text": "Vossos dons agradecemos",
              "bold": false
            },
            {
              "text": "Glória, glória, glória, glória",
              "bold": true
            }
          ]
        },
        {
          "id": 3,
          "type": "verse",
          "lines": [
            {
              "text": "Senhor, nosso Jesus Cristo",
              "bold": false
            },
            {
              "text": "Unigênito do Pai",
              "bold": false
            },
            {
              "text": "Voz de Deus, Cordeiro Santo",
              "bold": false
            },
            {
              "text": "Nossas culpas, perdoai",
              "bold": false
            }
          ]
        },
        {
          "id": 4,
          "type": "verse",
          "lines": [
            {
              "text": "Vós que estais junto do Pai",
              "bold": false
            },
            {
              "text": "Como nosso intercessor",
              "bold": false
            },
            {
              "text": "Acolhei nossos pedidos",
              "bold": false
            },
            {
              "text": "Atendei nosso clamor",
              "bold": false
            },
            {
              "text": "Glória, glória, glória, glória",
              "bold": true
            }
          ]
        },
        {
          "id": 5,
          "type": "verse",
          "lines": [
            {
              "text": "Vós somente sois o Santo",
              "bold": false
            },
            {
              "text": "O Altíssimo, o Senhor",
              "bold": false
            },
            {
              "text": "Com o Espírito Divino",
              "bold": false
            },
            {
              "text": "De Deus Pai no esplendor",
              "bold": false
            },
            {
              "text": "Glória, glória, glória, glória",
              "bold": true
            }
          ]
        }
