      "title": "Ó luz do Senhor",
      "artist": null,
      "source": "manual",
      "source_url": null,
      "stanzas": [
        {
          "id": 1,
          "type": "chorus",
          "lines": [
            {
              "text": "Ó luz do Senhor",
              "bold": true
            },
            {
              "text": "Que vem sobre a terra",
              "bold": true
            },
            {
              "text": "Inunda meu ser",
              "bold": true
            },
            {
              "text": "Permanece em nós",
              "bold": true
            }
          ]
        }
      ],
      "order": [
        1
      ]
    },
    "entrance": {
      "title": "Me chamaste para caminhar na vida contigo",
      "artist": null,
      "source": "manual",
      "source_url": null,
      "stanzas": [
        {
          "id": 1,
          "type": "verse",
          "lines": [
            {
              "text": "Me chamaste para caminhar na vida contigo",
              "bold": false
            },
            {
              "text": "Decidi para sempre seguir-te, não voltar atrás",
              "bold": false
            },
            {
              "text": "Me puseste uma brasa no peito e uma flecha na alma",
              "bold": false
            },
            {
              "text": "É difícil agora viver sem lembrar-me de ti",
              "bold": false
            }
          ]
        },
        {
          "id": 2,
          "type": "chorus",
          "lines": [
            {
              "text": "Te amarei, Senhor, te amarei, Senhor",
              "bold": true
            },
            {
              "text": "Eu só encontro a paz e a alegria bem perto de ti (te amarei)",
              "bold": true
            },
            {
              "text": "Te amarei Senhor, te amarei Senhor",
              "bold": true
            },
            {
              "text": "Eu só encontro a paz e a alegria bem perto de ti",
              "bold": true
            }
          ]
        },
        {
          "id": 3,
          "type": "verse",
          "lines": [
            {
              "text": "Eu pensei muitas vezes calar e não dar nem resposta",
              "bold": false
            },
            {
              "text": "Eu pensei na fuga esconder-me, ir longe de ti",
              "bold": false
            },
            {
              "text": "Mas tua força venceu e, ao final, eu fiquei seduzido",
              "bold": false
            },
            {
              "text": "É difícil agora viver sem saudades de ti",
              "bold": false
            }
          ]
        }
      ],
      "order": [
        1,
        2,
        3,
        2
      ]
    },
    "penitential_act": {
      "title": "Eu confesso a Deus e a vós irmãos",
      "artist": null,
      "source": "manual",
      "source_url": null,
      "stanzas": [
        {
          "id": 1,
          "type": "verse",
          "lines": [
            {
              "text": "Eu confesso a Deus e a vós irmãos",
              "bold": false
            },
            {
              "text": "Tantas vezes pequei, não fui fiel",
              "bold": false
            },
            {
              "text": "Pensamentos e palavras, atitudes e omissões",
              "bold": false
            },
            {
              "text": "Por minha culpa, tão grande culpa",
              "bold": false
            }
          ]
        },
        {
          "id": 2,
          "type": "chorus",
          "lines": [
            {
              "text": "Senhor piedade! Cristo, piedade!",
              "bold": true
            },
            {
              "text": "Tem piedade ó Senhor!",
              "bold": true
            },
            {
              "text": "Senhor piedade! Cristo, piedade!",
              "bold": true
            },
            {
              "text": "Tem piedade ó Senhor!",
              "bold": true
            }
          ]
        },
        {
          "id": 3,
          "type": "verse",
          "lines": [
            {
              "text": "Peço à Virgem Maria, nossa mãe",
              "bold": false
            },
            {
              "text": "E a vós meus irmãos, rogueis por mim",
              "bold": false
            },
            {
              "text": "A Deus pai que nos perdoa e nos sustenta em suas mãos",
              "bold": false
            },
            {
              "text": "Por seu amor",
              "bold": false
            },
            {
              "text": "Tão grande amor",
              "bold": false
            }
          ]
        }
      ],
      "order": [
        1,
        2,
        3,
        2
      ]
    },
    "gloria": {
